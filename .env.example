# Copy to `.env` and fill in values. Never commit real secrets.

# --- Database ---
# Local (default): SQLite, zero-config. `npm run setup` uses this.
DATABASE_URL="file:./dev.db"
# Production (Cloudflare): Neon or Supabase pooled Postgres URL.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Neon migrations/db push work best with the unpooled/direct URL:
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Force Prisma provider when the URL is not enough (Cloudflare **build** variable — required for Workers):
# PRISMA_PROVIDER="postgresql"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Local:
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production (invoiceflowstudio.com):
# AUTH_URL="https://invoiceflowstudio.com"
# NEXT_PUBLIC_APP_URL="https://invoiceflowstudio.com"
# Auth.js trustHost is enabled so Cloudflare's host header is trusted.

# Optional: GitHub OAuth (https://github.com/settings/developers)
# Homepage URL: https://invoiceflowstudio.com
# Callback URL: https://invoiceflowstudio.com/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional: Resend magic-link email (https://resend.com)
# If unset, magic-link sign-in is hidden. Email/password still works.
AUTH_RESEND_KEY=""
EMAIL_FROM="InvoiceFlow Studio <noreply@invoiceflowstudio.com>"

# --- Stripe ---
# Local: test keys (https://dashboard.stripe.com/test/apikeys). App runs without them.
# Production live Checkout: Worker *encrypted runtime secrets* (not plaintext Variables):
# STRIPE_SECRET_KEY=sk_live_…, STRIPE_WEBHOOK_SECRET=whsec_…, STRIPE_PRO_PRICE_ID=price_…
# (create the price in Live mode — test price ids fail against live keys).
# Plaintext dashboard vars are wiped on `wrangler deploy` unless wrangler.jsonc keep_vars
# is true; Secrets survive every Git deploy. Never commit a live price id here.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is unused (Checkout is a server action). If you add
# Stripe.js later, NEXT_PUBLIC_* must be a Cloudflare *Build* variable — Next inlines it
# at `next build`. Runtime-only pk_… will not change the Billing button or Checkout.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Production webhook URL: https://invoiceflowstudio.com/api/stripe/webhook

# Local demo Pro button. Must be "false" in production on Cloudflare.
AUTH_DEV_MODE="true"

# --- QuickBooks Online (optional, Phase 1 placeholder) ---
# Create an Intuit developer app, then set these as Worker secrets before live OAuth.
# INTUIT_CLIENT_ID=""
# INTUIT_CLIENT_SECRET=""
# INTUIT_REDIRECT_URI="https://invoiceflowstudio.com/dashboard/settings"
