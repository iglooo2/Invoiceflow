# Copy to `.env` and fill in values. Never commit real secrets.

# --- Database ---
# Local (default): SQLite, zero-config. `npm run setup` uses this.
DATABASE_URL="file:./dev.db"
# Production (Cloudflare): Neon or Supabase pooled Postgres URL.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Neon migrations/db push work best with the unpooled/direct URL:
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Force Prisma provider when the URL is not enough (Cloudflare **build** variable — required for Workers):
# PRISMA_PROVIDER="postgresql"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
# Production: AUTH_SECRET MUST be a Worker *Runtime* Secret (Settings → Variables
# and Secrets). A Cloudflare *Build* variable is visible at `cf:build` only —
# Auth.js signs JWTs at request time from Worker env. Build-only AUTH_SECRET
# causes CredentialsSignin / missing-secret errors even when AUTH_GOOGLE_* work.
AUTH_SECRET="replace-with-a-long-random-string"
# Local:
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production (invoiceflowstudio.com):
# AUTH_URL="https://invoiceflowstudio.com"   # Runtime variable, not only Build
# NEXT_PUBLIC_APP_URL="https://invoiceflowstudio.com"
# Auth.js trustHost is enabled so Cloudflare's host header is trusted.
# Production Runtime: AUTH_URL="https://invoiceflowstudio.com" (do not leave this
# as localhost if a Worker build inlines .env).
# AUTH_SECRET and AUTH_URL must both exist as Runtime secrets/vars. Build-only
# AUTH_SECRET is not copied onto Worker env and Auth.js will not see it.

# Optional: Google Sign-In (https://console.cloud.google.com/apis/credentials)
# Buttons always show on /login. Without these secrets the Google button is disabled.
# Homepage: https://invoiceflowstudio.com
# Authorized redirect: https://invoiceflowstudio.com/api/auth/callback/google
# Local redirect: http://localhost:3000/api/auth/callback/google
# Auth.js v5 names (https://authjs.dev/getting-started/providers/google).
# Google Cloud Console labels these Client ID / Client Secret; do not only set
# GOOGLE_CLIENT_ID — that is accepted as an alias, but AUTH_GOOGLE_ID is the
# documented Worker secret name.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Optional: GitHub OAuth (https://github.com/settings/developers)
# Homepage URL: https://invoiceflowstudio.com
# Callback URL: https://invoiceflowstudio.com/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Required on production Workers for Message us + magic link:
# AUTH_RESEND_KEY must be a Cloudflare *Runtime* Secret (not only a Build variable).
# RESEND_API_KEY is accepted as an alias. Without either, /contact shows
# “Email isn’t configured” (it does not hang).
# EMAIL_FROM must use a domain verified in Resend (invoiceflowstudio.com).
AUTH_RESEND_KEY=""
EMAIL_FROM="InvoiceFlow Studio <noreply@invoiceflowstudio.com>"
# Optional inbox override (defaults to CONTACT_EMAIL in lib/site.ts):
# CONTACT_TO="galit.igor@yahoo.com"

# Optional: Phone SMS sign-in (https://console.twilio.com)
# Prefer Twilio Verify for the one-time code. Buttons always show on /login; disabled until secrets are set.
# Cloudflare: these MUST be Worker *Runtime* Secrets (Settings → Variables and Secrets).
# A User is created only after the website code check succeeds. New registrations then send a
# second confirmation SMS ("Your InvoiceFlow Studio account is confirmed") via Programmable SMS,
# so set TWILIO_FROM_NUMBER even when using Verify for the OTP.
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN=""
# TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_FROM_NUMBER="+15555550100"
# TWILIO_PHONE_NUMBER is accepted as an alias for TWILIO_FROM_NUMBER.

# --- Stripe ---
# Local: test keys (https://dashboard.stripe.com/test/apikeys). App runs without them.
# Production live Checkout: Worker *encrypted runtime secrets* (not plaintext Variables):
# STRIPE_SECRET_KEY=sk_live_…, STRIPE_WEBHOOK_SECRET=whsec_…, STRIPE_PRO_PRICE_ID=price_…
# (create the price in Live mode — test price ids fail against live keys).
# Plaintext dashboard vars are wiped on `wrangler deploy` unless wrangler.jsonc keep_vars
# is true; Secrets survive every Git deploy. Never commit a live price id here.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is unused (Checkout is a server action). If you add
# Stripe.js later, NEXT_PUBLIC_* must be a Cloudflare *Build* variable — Next inlines it
# at `next build`. Runtime-only pk_… will not change the Billing button or Checkout.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Production webhook URL: https://invoiceflowstudio.com/api/stripe/webhook

# Local demo Pro button. Must be "false" in production on Cloudflare.
AUTH_DEV_MODE="true"

# --- Homepage partner slot (optional) ---
# Empty name = labeled “Advertise here” placeholder on the landing page + footer.
# Set name + URL to go live. Logo and blurb are optional. Cloudflare Runtime
# vars work without a redesign — edit lib/sponsor.ts SPONSOR_DEFAULTS if you
# prefer a code constant.
# SPONSOR_NAME="Example Tools"
# SPONSOR_URL="https://example.com"
# SPONSOR_LOGO_URL="https://example.com/logo.png"
# SPONSOR_BLURB="Job-site gear for contractors who invoice."

# --- QuickBooks Online (optional, Phase 1 placeholder) ---
# Create an Intuit developer app, then set these as Worker secrets before live OAuth.
# INTUIT_CLIENT_ID=""
# INTUIT_CLIENT_SECRET=""
# INTUIT_REDIRECT_URI="https://invoiceflowstudio.com/dashboard/settings"
