# Copy to `.env` and fill in values. Never commit real secrets.
# Local SQLite (zero-config demo):
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional: Resend magic-link email (https://resend.com)
# If unset, magic-link sign-in is hidden. Email/password still works.
AUTH_RESEND_KEY=""
EMAIL_FROM="InvoiceFlow <noreply@example.com>"

# Stripe test mode (https://dashboard.stripe.com/test/apikeys)
# App runs without these: billing page shows setup + a local demo upgrade.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# When true, billing page offers "Unlock Pro for local demo" without Stripe.
AUTH_DEV_MODE="true"
