generator client {
  provider = "prisma-client-js"
}

// Default provider is SQLite for `npm run setup`.
// `scripts/prisma.mjs` rewrites this to postgresql when DATABASE_URL is
// postgres://, PRISMA_PROVIDER=postgresql, or Cloudflare CI (WORKERS_CI=1).
// Postgres generate also sets engineType to the rust-free client (Workers / Neon HTTP).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  businessName    String?
  businessEmail   String?
  businessPhone   String?
  businessAddress String?
  website         String?

  plan                   String    @default("free")
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  Account[]
  sessions  Session[]
  clients   Client[]
  invoices  Invoice[]
  proposals Proposal[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String?
  company   String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
  proposals Proposal[]
}

model Invoice {
  id          String    @id @default(cuid())
  userId      String
  clientId    String?
  number      String
  status      String    @default("draft")
  issueDate   DateTime  @default(now())
  dueDate     DateTime?
  taxRate     Float     @default(0)
  notes       String?
  currency    String    @default("USD")
  publicToken String    @unique
  poNumber    String?
  clientName  String
  clientEmail String?
  clientCompany String?
  clientAddress String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items  InvoiceItem[]

  @@unique([userId, number])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float
  rate        Float
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Proposal {
  id            String    @id @default(cuid())
  userId        String
  clientId      String?
  title         String
  status        String    @default("draft")
  validUntil    DateTime?
  notes         String?
  currency      String    @default("USD")
  publicToken   String    @unique
  clientName    String
  clientEmail   String?
  clientCompany String?
  taxRate       Float     @default(0)
  markupRate    Float     @default(0)
  viewedAt      DateTime?
  signedName    String?
  signedAt      DateTime?
  attachments   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sections ProposalSection[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

model ProposalSection {
  id         String  @id @default(cuid())
  proposalId String
  heading    String
  body       String
  amount     Float?
  sortOrder  Int     @default(0)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model DocumentTemplate {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  kind        String
  description String
  payload     Json
}
