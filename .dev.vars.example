# Used by `wrangler dev` / `opennextjs-cloudflare preview`.
# Copy to `.dev.vars` — never commit real secrets.
#
# Worker preview cannot use SQLite. Point DATABASE_URL at Neon/Supabase.
# For the local Next.js demo, keep `.env` as `file:./dev.db` and use `npm run dev`.

NEXTJS_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-string"
# Production: AUTH_SECRET + AUTH_URL must be Worker Runtime secrets/vars,
# not only Cloudflare Build variables.
AUTH_URL="http://localhost:8787"
NEXT_PUBLIC_APP_URL="http://localhost:8787"
AUTH_DEV_MODE="false"

# Optional Google Sign-In (Worker runtime secrets).
# Auth.js names: AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET (preferred).
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are accepted as aliases.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Optional phone SMS (Worker runtime secrets). Verify for the OTP; From number for
# the new-account confirmation SMS (and as OTP fallback if Verify is unset).
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_VERIFY_SERVICE_SID=""
# TWILIO_FROM_NUMBER=""

# Stripe (optional). Production must use encrypted Worker Secrets — not plaintext
# dashboard Variables. wrangler.jsonc keep_vars keeps dashboard text vars on
# `wrangler deploy`; Secrets survive every Git / preview deploy either way.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."

# Optional homepage partner slot. Empty = labeled “Advertise here” placeholder.
# SPONSOR_NAME=""
# SPONSOR_URL=""
# SPONSOR_LOGO_URL=""
# SPONSOR_BLURB=""

# Contact form + magic-link email. Production Worker Runtime Secret:
# AUTH_RESEND_KEY (alias RESEND_API_KEY). EMAIL_FROM must be a verified domain.
# Optional CONTACT_TO overrides the inbox (defaults to lib/site.ts CONTACT_EMAIL).
# AUTH_RESEND_KEY=""
# EMAIL_FROM="InvoiceFlow Studio <noreply@invoiceflowstudio.com>"
# CONTACT_TO="galit.igor@yahoo.com"

# QuickBooks Online (optional). Live OAuth is not enabled yet.
# INTUIT_CLIENT_ID=""
# INTUIT_CLIENT_SECRET=""
