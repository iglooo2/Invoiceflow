{
  "name": "invoiceflow",
  "version": "0.1.0",
  "private": true,
  "description": "InvoiceFlow Studio — fast invoices and estimates for freelancers and contractors.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/prisma.mjs generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test lib/money.test.ts lib/plans.test.ts lib/site.test.ts lib/i18n.test.ts lib/contact.test.ts lib/db.test.ts lib/invoice-input.test.ts lib/proposal-input.test.ts lib/document-writes.test.ts lib/subscription-writes.test.ts lib/stripe.test.ts lib/stripe-billing.test.ts lib/pdf.test.ts lib/estimates.test.ts lib/proposal-queries.test.ts lib/quickbooks.test.ts lib/onboarding.test.ts lib/studio-settings.test.ts lib/referrals.test.ts lib/auth-env.test.ts lib/csv.test.ts scripts/prisma-schema.test.ts scripts/prisma-cf-wasm.test.ts scripts/brand-copy.test.ts",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:push": "node scripts/prisma.mjs db push",
    "db:push:prod": "node scripts/prisma.mjs db push --require-postgres",
    "db:migrate:prod": "node scripts/prisma.mjs migrate deploy --require-postgres",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/prisma.mjs db push --force-reset && tsx prisma/seed.ts",
    "setup": "node scripts/prisma.mjs generate && node scripts/prisma.mjs db push && tsx prisma/seed.ts",
    "postinstall": "node scripts/prisma.mjs generate",
    "preview": "node scripts/cf-build.mjs build && opennextjs-cloudflare preview",
    "deploy": "node scripts/cf-build.mjs build && opennextjs-cloudflare deploy",
    "cf:build": "node scripts/cf-build.mjs build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.46.0",
    "nanoid": "^5.1.5",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "pg-cloudflare": "^1.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.1.2",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "wrangler": "^4.131.2"
  }
}
